<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Verbilume" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/terracotta</item>
    </style>

    <style name="Theme.Verbilume.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ink</item>
        <item name="postSplashScreenTheme">@style/Theme.Verbilume</item>
    </style>
</resources>
